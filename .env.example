# Copy to .env.local and fill in. Never commit the filled-in copy.

# Neon Postgres. The collector upserts into it every night; the dashboard reads
# from it on each request, so new readings appear without a redeploy.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Sign-in gate for the dashboard. Leave both blank to serve publicly.
TOKENWATT_USER=
TOKENWATT_PASS=

# Signs the session cookie. Any long random string; rotate it to log every
# device out at once. Falls back to TOKENWATT_PASS when unset.
TOKENWATT_SESSION_SECRET=

# Bearer token for POST /api/ingest, used to push readings from a machine that
# cannot reach the database directly. Leave blank to disable the endpoint.
TOKENWATT_INGEST_TOKEN=
